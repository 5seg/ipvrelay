#!/sbin/openrc-run
# OpenRC service for Alpine. Install as root:
#   install -m 755 ipvrelay /usr/local/bin/ipvrelay
#   install -m 755 ipvrelay.openrc /etc/init.d/ipvrelay
#   rc-update add ipvrelay default && rc-service ipvrelay start
#
# The proxy runs as an unprivileged user, so it uses the userspace tunnel
# backend. IPVRELAY_STATE is set explicitly because the service inherits root's
# environment, not the target user's.

name="ipvrelay"
description="SOCKS5 proxy whose exit is an IPVanish WireGuard server"

command="/usr/local/bin/ipvrelay"
command_args="--no-tui --listen ${IPVRELAY_LISTEN:-127.0.0.1:1080} --control ${IPVRELAY_CONTROL:-unix:/home/${IPVRELAY_USER:-user}/.local/state/ipvrelay/control.sock}"
command_user="${IPVRELAY_USER:-user}"

pidfile="/run/${RC_SVCNAME}.pid"
command_background="yes"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

export IPVRELAY_STATE="${IPVRELAY_STATE:-/home/${command_user}/.local/state/ipvrelay/state.json}"

depend() {
	need net
	after firewall tailscale
}

start_pre() {
	checkpath --file --mode 0640 --owner "${command_user}:${command_user}" "$output_log"
}
